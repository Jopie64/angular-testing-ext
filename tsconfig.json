{
    "compileOnSave": false,
    "compilerOptions": {
      "outDir": "./dist/out-tsc",
      "rootDir": "./src",
      "sourceMap": true,
      "declaration": true,
      "moduleResolution": "bundler",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "module": "esnext",
      "target": "es2022",
      "typeRoots": [
        "node_modules/@types"
      ],
      "lib": [
        "es2017",
        "dom"
      ]
    }
}
